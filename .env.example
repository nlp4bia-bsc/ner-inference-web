DEVICE=auto
WORKER_CONCURRENCY=1
# Optional technical cap, separate from per-account 100 / 1000 / UNLIMITED.
MAX_DOCUMENTS_PER_JOB=
JOB_RESULTS_TTL_HOURS=72
RATE_LIMIT_SECONDS=60
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=250
MAX_DOCUMENT_MB=5
MAX_ZIP_ENTRIES=5000
MAX_COMPRESSION_RATIO=100
MAX_QUEUE_SIZE=100
MAX_STORAGE_MB=10000
MIN_FREE_DISK_MB=500
MAX_CONCURRENT_UPLOADS=4
MAX_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=60
TOMBSTONE_HOURS=24
MODEL_CONFIG_PATH=catalog/models.yaml
MODEL_VALIDATION_PATH=catalog/validated-models.json
STORAGE_ROOT=storage
# Local mode also accepts localhost on this same scheme/port.
PUBLIC_BASE_URL=http://127.0.0.1:8000
MODEL_LOADING_MODE=on_demand
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_TOKEN=

APP_PREFIX=

INFERENCE_DOCUMENT_BATCH_SIZE=32
MAX_LOADED_MODELS=2
STORAGE_RESERVE_FACTOR=4
STORAGE_RESERVE_EXTRA_MB=32

# Runtime libraries only; no model weights are downloaded during image build.
INSTALL_NLP=true
NLP_PROFILE=cpu

# LOCAL DEVELOPMENT ONLY. Production must set APP_ENV=production,
# COOKIE_SECURE=true and an HTTPS PUBLIC_BASE_URL matching the public address.
# SMTP is optional for recovery or explicitly enabled email verification.
APP_ENV=development
COOKIE_SECURE=false
MAIL_BACKEND=none
REQUIRE_EMAIL_VERIFICATION=false
SUPPORT_EMAIL=fernando.gallego@bsc.es
SESSION_MAX_SECONDS=43200
SESSION_IDLE_SECONDS=1800
VERIFICATION_SECONDS=86400
RESET_SECONDS=1800
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_EMAIL_ATTEMPTS=10
AUTH_RATE_IP_ATTEMPTS=60
AUDIT_RETENTION_DAYS=365
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
