DEVICE=auto
WORKER_CONCURRENCY=1
# Optional technical cap, separate from per-account 100 / 1000 / UNLIMITED.
MAX_DOCUMENTS_PER_JOB=
JOB_RESULTS_TTL_HOURS=72
RATE_LIMIT_SECONDS=60
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=250
MAX_DOCUMENT_MB=5
MAX_ZIP_ENTRIES=5000
MAX_COMPRESSION_RATIO=100
MAX_QUEUE_SIZE=100
MAX_STORAGE_MB=10000
MIN_FREE_DISK_MB=500
MAX_CONCURRENT_UPLOADS=4
MAX_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=60
TOMBSTONE_HOURS=24
MODEL_CONFIG_PATH=catalog/models.yaml
MODEL_VALIDATION_PATH=catalog/validated-models.json
STORAGE_ROOT=storage
PUBLIC_BASE_URL=http://localhost:8000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

APP_PREFIX=

INFERENCE_DOCUMENT_BATCH_SIZE=32
MAX_LOADED_MODELS=2
STORAGE_RESERVE_FACTOR=4
STORAGE_RESERVE_EXTRA_MB=32

# Build-time neural profile; default image remains non-NLP.
NLP_PROFILE=cpu

# LOCAL DEVELOPMENT ONLY. Production must set APP_ENV=production,
# COOKIE_SECURE=true, HTTPS PUBLIC_BASE_URL and real STARTTLS SMTP.
APP_ENV=development
COOKIE_SECURE=false
MAIL_BACKEND=file
SESSION_MAX_SECONDS=43200
SESSION_IDLE_SECONDS=1800
VERIFICATION_SECONDS=86400
RESET_SECONDS=1800
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_EMAIL_ATTEMPTS=10
AUTH_RATE_IP_ATTEMPTS=60
AUDIT_RETENTION_DAYS=365
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
